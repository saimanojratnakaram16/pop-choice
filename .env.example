# Example environment variables (do NOT store secrets in the repo)
# Copy this to .env locally and fill values before running locally

# Server-only (keep these secret and store them in a secure secret manager)
OPENAI_API_KEY=REDACTED
SUPABASE_API_KEY=REDACTED
SUPABASE_URL=https://your-project.supabase.co

# Client-safe (these should be public/anon keys only)
VITE_OPENAI_API_KEY=REDACTED
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=REDACTED
